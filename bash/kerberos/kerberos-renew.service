[Unit]
Description=Refresh Kerberos ticket (renew or re-authenticate via keytab)
Documentation=man:kinit(1) man:klist(1)

[Service]
Type=oneshot
# %h is systemd's expansion for $HOME of the running user.
ExecStart=%h/dotfiles-cluster/scripts/kerberos/check_ticket.sh

# Don't tie to a tty; we may run unattended.
StandardOutput=journal
StandardError=journal

# Lightweight hardening (this is a user-level unit so most options are no-ops,
# but the harmless ones are still good practice).
NoNewPrivileges=yes
ProtectSystem=true
PrivateTmp=true

[Install]
WantedBy=default.target
