[Unit]
Description=Periodically refresh Kerberos ticket
Documentation=man:systemd.timer(5)

[Timer]
# 5 minutes after login, then every 6 hours after that.
OnStartupSec=5min
OnUnitActiveSec=6h

# If the machine was suspended/asleep when the timer should have fired,
# run it as soon as we wake up.
Persistent=true

# Stagger by up to 5 minutes to avoid every machine hitting the KDC at once.
RandomizedDelaySec=5min

# Match the .service unit's name.
Unit=kerberos-renew.service

[Install]
WantedBy=timers.target
